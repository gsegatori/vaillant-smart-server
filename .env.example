# --- Network ---
BIND_HOST=0.0.0.0
BIND_PORT=5000

# --- Vaillant account (myPyllant) ---
VAILLANT_USER=your-email@example.com
VAILLANT_PASSWORD=changeme
VAILLANT_BRAND=vaillant
VAILLANT_COUNTRY=italy

# --- Cache persistente (path nel container o sul filesystem) ---
CACHE_FILE=/data/cache.json

# --- TTL in secondi per ogni tipo di dato ---
# Bilanciamento: piu' lungo = meno chiamate API Vaillant ma dati piu' vecchi nella sitemap.
# Tutte le risposte vengono comunque serve-stale se la fetch upstream fallisce.
CACHE_TTL_SYSTEM_INFO=300
CACHE_TTL_ZONE_INFO=300
CACHE_TTL_ZONE_FLOW=300
CACHE_TTL_ZONES=1800
CACHE_TTL_WATER_PRESSURE=600
CACHE_TTL_GAS=14400

# --- Retry/backoff su errori transient (429/5xx/timeout dell'API Vaillant) ---
RETRIES=3
RETRY_BACKOFF_BASE_S=2

# --- Master kill-switch persistito (vedi /admin/enable e /admin/disable) ---
# Se la chiave non esiste in cache, default = abilitato.
# Quando false, gli endpoint servono SOLO valori cachati (anche scaduti); niente chiamate upstream.

# --- Logging ---
LOG_LEVEL=INFO
